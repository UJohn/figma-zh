{
  "manifest_version": 3,
  "name": "Figma 中文汉化",
  "version": "1.5.0",
  "description": "把 Figma 网页版界面汉化为简体中文：菜单、面板、右键菜单、设置、分享、订阅等。离线词表，不联网，不改动画布内容。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.figma.com/*",
    "https://figma.com/*",
    "https://support-chat.figma.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.figma.com/*",
        "https://figma.com/*",
        "https://support-chat.figma.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Figma 中文汉化",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "homepage_url": "https://github.com/UJohn/figma-zh"
}